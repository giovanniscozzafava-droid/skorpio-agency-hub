---
import { getCollection } from 'astro:content';
import { SITE, amazonLink, amazonTagFor, AMAZON_CHANNELS } from '../../../data/site';

export async function getStaticPaths() {
  const packs = await getCollection('packs');
  const paths = [];
  for (const p of packs) {
    p.data.products.forEach((prod, i) => {
      const links: Record<string, string> = {};
      for (const ch of AMAZON_CHANNELS) links[ch] = amazonLink(prod, amazonTagFor(ch));
      paths.push({
        params: { slug: p.id, n: String(i + 1) },
        props: { links, productName: prod.name, activity: p.data.activity, packSlug: p.id },
      });
    });
  }
  return paths;
}

const { links, productName, activity, packSlug } = Astro.props;
const fallback = links.web;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="referrer" content="no-referrer-when-downgrade" />
  <title>Ti portiamo su Amazon.it… · {SITE.name}</title>
  <meta http-equiv="refresh" content={`1;url=${fallback}`} />
  <script type="application/json" id="msp-links" set:html={JSON.stringify(links)} />
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #FAF7F2; color: #2B2B2B;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; text-align: center; padding: 24px; }
    .card { max-width: 420px; }
    h1 { font-size: 22px; color: #1B1F3B; margin: 0 0 10px; }
    p { font-size: 15px; line-height: 1.6; margin: 0 0 10px; }
    .muted { color: #6B6F80; font-size: 13px; }
    a { color: #1B1F3B; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Ti portiamo su Amazon.it…</h1>
    <p>{productName} · starter pack {activity}</p>
    <p class="muted">Link affiliato: se acquisti riceviamo una commissione, il prezzo per te non cambia.</p>
    <p><a id="msp-go" href={fallback} rel="sponsored nofollow noopener">Se non parte, apri la pagina qui</a></p>
    <p class="muted"><a href={`${SITE.url}/pack/${packSlug}`}>Torna allo starter pack {activity}</a></p>
  </div>
  <script is:inline>
    (function () {
      var el = document.getElementById('msp-links');
      var links = {};
      try { links = JSON.parse(el.textContent || '{}'); } catch (e) { links = {}; }
      var src = '';
      try { src = (new URLSearchParams(location.search).get('src') || '').toLowerCase(); } catch (e) { src = ''; }
      var allowed = ['ig', 'tt', 'yt', 'pin', 'nl'];
      var channel = allowed.indexOf(src) !== -1 ? src : 'web';
      var url = links[channel] || links.web;
      if (!url) return;
      var a = document.getElementById('msp-go');
      if (a) a.setAttribute('href', url);
      location.replace(url);
    })();
  </script>
</body>
</html>
